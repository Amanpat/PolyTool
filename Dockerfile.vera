# syntax=docker/dockerfile:1

# Vera operator Discord bot — Phase A (skeleton + /ping).
# Lean image: discord.py only ([discord] extra). No py-clob-client, no RAG/MCP/
# studio/dev/historical, no build tools in the runtime image. Least privilege:
# the bot opens an outbound gateway connection, exposes no ports, and does no
# trading / gate / execution work.

# ── Stage 1: builder ─────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Copy the manifest + the real package source setuptools declares, THEN install.
# (The declared packages must exist on disk at build time, so the install can
# only run after the source is present.) polytool/, packages/, tools/ are in the
# build context; README.md is NOT (it is excluded by .dockerignore), so — like
# the root Dockerfile — stub it inline to satisfy setuptools metadata.
COPY pyproject.toml ./
COPY polytool/ ./polytool/
COPY packages/ ./packages/
COPY tools/ ./tools/

# Install polytool + the [discord] extra (discord.py). discord.py and its deps
# ship manylinux wheels, so no gcc/build-tools are needed in this image.
RUN --mount=type=cache,target=/root/.cache/pip \
    echo "# PolyTool" > README.md \
    && pip install --upgrade pip \
    && pip install ".[discord]"

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /app/polytool ./polytool/
COPY --from=builder /app/packages ./packages/
COPY --from=builder /app/tools ./tools/

# Run as a non-root user (no privileged work needed).
RUN groupadd -r vera && useradd -r -g vera -m vera && chown -R vera:vera /app
USER vera

# Long-lived service: connect to the gateway and serve /ping.
# DISCORD_BOT_TOKEN is injected from .env via compose env_file (never baked in).
CMD ["python", "-m", "packages.polymarket.discord_bot"]
