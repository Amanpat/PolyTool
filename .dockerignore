# Version control
.git
.github

# Python bytecode / build artifacts
.venv
__pycache__
*.pyc
*.pyo
*.pyd
*.egg-info
polytool.egg-info/

# Test / lint caches
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov/

# Artifacts (large, gitignored, mounted as volumes)
artifacts/
kb/
docker_data/

# Local model cache and database files (future-proof)
# Prevents accidental inclusion if a cache dir or DB file lands in the repo root.
.cache/
.huggingface/
*.duckdb
*.sqlite
*.sqlite3
*.db

# Not needed at build time (docs, tests, infra, scripts, config)
docs/
tests/
infra/
scripts/
config/
.planning/
.claude/
.tmp/

# AI tool data directories (not needed in build context, can be large)
.opencode/
.gemini/
.githooks/

# Node / frontend
node_modules/
dist/
build/

# Environment and secrets
.env
.env.*
!.env.example

# Misc
mcp_stdout.txt
mcp_stderr.txt
*.log
logs/
tmp/
quarantine/
LICENSE
README.md
CLAUDE.md
claude.md
AGENTS.md
requirements-rag.txt
pyrightconfig.json
wf_detail.json
